+++ b/src/sokol_impl.c
@@ -11,9 +11,49 @@
 // *************************************************************************
 
 #define SOKOL_IMPL
+#define SOKOL_DEBUG
+#include <stdio.h>
+#define SOKOL_LOG(msg) fprintf(stderr, "sokol: %s\n", msg)
+#if defined(SOKOL_GLCORE33)
+#define sg_make_shader sg_make_shader_raw
+#endif
 
 #include <sokol_gfx.h>
 #include <sokol_app.h>
 #include <sokol_glue.h>
 #include <sokol_time.h>
 #include <sokol_args.h>
+
+#if defined(SOKOL_GLCORE33)
+// Synchronous capture from the actual RGBA render target, with top-left rows
+// matching the cross-platform PNG capture API. No window scaling is involved.
+bool atlas_gl_read_rect(uint32_t id, int x, int y, int w, int h, uint8_t* out)
+{
+    _sg_image_t* image = _sg_lookup_image(&_sg.pools, id);
+    if (!image || image->slot.state != SG_RESOURCESTATE_VALID || !out ||
+        x < 0 || y < 0 || w <= 0 || h <= 0 ||
+        x + w > image->cmn.width || y + h > image->cmn.height) return false;
+    GLint previous = 0;
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &previous);
+    GLuint framebuffer = 0;
+    glGenFramebuffers(1, &framebuffer);
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                          image->gl.tex[image->cmn.active_slot], 0);
+    bool ok = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    if (ok) {
+        glReadPixels(x, image->cmn.height - y - h, w, h, GL_RGBA, GL_UNSIGNED_BYTE, out);
+        for (int row = 0; row < h / 2; ++row) {
+            uint8_t* a = out + (size_t)row * w * 4;
+            uint8_t* b = out + (size_t)(h - row - 1) * w * 4;
+            for (int column = 0; column < w * 4; ++column) {
+                uint8_t byte = a[column]; a[column] = b[column]; b[column] = byte;
+            }
+        }
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, (GLuint)previous);
+    glDeleteFramebuffers(1, &framebuffer);
+    sg_reset_state_cache();
+    return ok;
+}
+#endif
