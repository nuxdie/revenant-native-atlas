diff --git a/src/glslcompat.cpp b/src/glslcompat.cpp
new file mode 100644
--- /dev/null
+++ b/src/glslcompat.cpp
@@ -0,0 +1,82 @@
+// Local Linux capture compatibility. This Sokol revision uploads individual
+// uniforms; the port's GLSL strings instead declare std140 interface blocks.
+// Lower those declarations and isolate stage names before compiling them.
+#include <sokol_gfx.h>
+#if defined(SOKOL_GLCORE33)
+#include <list>
+#include <regex>
+#include <set>
+#include <string>
+
+extern "C" sg_shader sg_make_shader_raw(const sg_shader_desc*);
+
+static int UniformBytes(sg_uniform_type t)
+{
+    switch (t) {
+    case SG_UNIFORMTYPE_FLOAT: case SG_UNIFORMTYPE_INT: return 4;
+    case SG_UNIFORMTYPE_FLOAT2: case SG_UNIFORMTYPE_INT2: return 8;
+    case SG_UNIFORMTYPE_FLOAT3: case SG_UNIFORMTYPE_INT3: return 12;
+    case SG_UNIFORMTYPE_FLOAT4: case SG_UNIFORMTYPE_INT4: return 16;
+    case SG_UNIFORMTYPE_MAT4: return 64;
+    default: return 0;
+    }
+}
+
+static std::string LowerStage(sg_shader_stage_desc& stage, const char* prefix,
+                              std::list<std::string>& names)
+{
+    if (!stage.source) return {};
+    std::string source(stage.source), lowered;
+    const std::regex block(R"(layout\s*\(\s*std140\s*\)\s*uniform\s+\w+\s*\{([^}]+)\}\s*;)");
+    const std::regex member(R"((\w+)\s+(\w+)\s*(\[[^\]]+\])?\s*;)");
+    std::set<std::string> members;
+    std::smatch match;
+    while (std::regex_search(source, match, block)) {
+        lowered += match.prefix().str();
+        std::string body = match[1].str();
+        for (auto it = std::sregex_iterator(body.begin(), body.end(), member);
+             it != std::sregex_iterator(); ++it) {
+            members.insert((*it)[2].str());
+            lowered += "uniform " + (*it)[1].str() + " " + (*it)[2].str() + (*it)[3].str() + ";\n";
+        }
+        source = match.suffix().str();
+    }
+    lowered += source;
+    for (const auto& name : members)
+        lowered = std::regex_replace(lowered, std::regex("\\b" + name + "\\b"), std::string(prefix) + name);
+    for (auto& ub : stage.uniform_blocks) {
+        size_t bytes = 0;
+        int count = 0;
+        for (auto& u : ub.uniforms) {
+            if (u.type == SG_UNIFORMTYPE_INVALID) break;
+            bytes += UniformBytes(u.type) * (u.array_count > 0 ? u.array_count : 1);
+            if (u.name && members.count(u.name)) {
+                names.emplace_back(std::string(prefix) + u.name);
+                u.name = names.back().c_str();
+            }
+            ++count;
+        }
+        // Composite VS reserves the whole shared 4-vec4 record, while only
+        // listing two members. Retain its byte offsets with inactive padding.
+        while (bytes + 16 <= ub.size && count < SG_MAX_UB_MEMBERS) {
+            auto& u = ub.uniforms[count++];
+            names.emplace_back(std::string(prefix) + "unused_" + std::to_string(count));
+            u.name = names.back().c_str();
+            u.type = SG_UNIFORMTYPE_FLOAT4;
+            bytes += 16;
+        }
+    }
+    return lowered;
+}
+
+extern "C" sg_shader sg_make_shader(const sg_shader_desc* original)
+{
+    sg_shader_desc desc = *original;
+    std::list<std::string> names;
+    std::string vs = LowerStage(desc.vs, "vertex_", names);
+    std::string fs = LowerStage(desc.fs, "fragment_", names);
+    if (desc.vs.source) desc.vs.source = vs.c_str();
+    if (desc.fs.source) desc.fs.source = fs.c_str();
+    return sg_make_shader_raw(&desc);
+}
+#endif
